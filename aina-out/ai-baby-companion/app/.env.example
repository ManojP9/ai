APP_NAME=Companion Console
APP_TAGLINE=Parent control plane for the AI Baby Companion.
PORT=8000

# AES-256-GCM key for at-rest encryption (use a secrets manager in prod; never commit)
COMPANION_ENC_KEY=change-me-to-a-32-byte-secret
# Conversation turns auto-expire after this many days (daily retention cron)
COMPANION_RETENTION_DAYS=30
# Firmware version advertised by the OTA manifest endpoint
COMPANION_FW_VERSION=1.2.0
